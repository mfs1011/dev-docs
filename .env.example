# Supabase → Project Settings → API. Ikkalasi ham ochiq kalit (brauzerga boradi),
# himoya bazadagi RLS qoidalarida. Bo'sh qolsa — akkaunt tugmasi ko'rinmaydi.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Kirish usullari (Supabase'da ham yoqilgan bo'lishi kerak): github, google
VITE_AUTH_PROVIDERS=github,google

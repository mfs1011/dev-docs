# Load balancer: upstream ichi ssenariyga qarab almashtiriladi (olchov.sh). nginx (ochiq manba) da faol
# health check yo'q — faqat passiv: max_fails (standart 1) va fail_timeout (standart 10 s).
events { worker_connections 4096; }
http {
  access_log /dev/stdout combined;
  upstream ilovalar {
    __UPSTREAM__
  }
  server {
    listen 80;
    location / {
      proxy_pass http://ilovalar;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      add_header X-Upstream $upstream_addr always;
    }
  }
}
